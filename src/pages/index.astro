---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;

const primary =
  "inline-flex items-center justify-center rounded-lg bg-purple-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-purple-500";
const secondary =
  "inline-flex items-center justify-center rounded-lg border border-white/20 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-white/10";
---

<Layout title="Authenticheck" lang="pl">
  <main class="bg-cosmic flex min-h-screen flex-col items-center justify-center px-4 py-16 text-center text-white">
    <h1
      class="bg-gradient-to-r from-blue-200 via-purple-200 to-pink-200 bg-clip-text text-5xl leading-tight font-bold text-transparent sm:text-6xl"
    >
      Authenticheck
    </h1>
    <p class="mt-4 max-w-xl text-lg text-blue-100/70">
      Sprawdź używaną torebkę Balenciaga City, zanim ją kupisz: przepisz, co widać na zdjęciach metki, i dostań raport
      ryzyka z pytaniami do sprzedawcy.
    </p>
    {
      user ? (
        <>
          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <a href="/verifications/new" class:list={primary}>
              Nowa weryfikacja
            </a>
            <a href="/verifications" class:list={secondary}>
              Moje weryfikacje
            </a>
          </div>
          <p class="mt-8 text-sm text-blue-100/60">Zalogowano jako {user.email}</p>
          <form method="POST" action="/api/auth/signout" class="mt-2">
            <button
              type="submit"
              class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline"
            >
              Wyloguj się
            </button>
          </form>
        </>
      ) : (
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a href="/auth/signin" class:list={primary}>
            Zaloguj się
          </a>
          <a href="/auth/signup" class:list={secondary}>
            Załóż konto
          </a>
        </div>
      )
    }
  </main>
</Layout>
